# Copy to a protected local file, replace values, and exclude it from Git.
# Each agent must have a separate random token of at least 43 URL-safe characters.
PUDDING_JDBC_URL=jdbc:postgresql://DB_HOST:5432/pudding?sslmode=verify-full
PUDDING_DB_USER=pudding_runtime
PUDDING_DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
PUDDING_ALLOWED_HOSTS=pudding.example
PUDDING_ALLOWED_ORIGINS=https://pudding.example
PUDDING_AGENT_CREDENTIALS=[{"agent_id":"agent_one","token":"<GENERATE_A_PRIVATE_TOKEN_BEFORE_STARTUP>"}]
